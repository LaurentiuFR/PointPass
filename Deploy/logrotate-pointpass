/var/log/nginx/pointpass-*.log {
    daily
    rotate 7
    maxsize 10M
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        if [ -f /run/nginx.pid ]; then
            kill -USR1 "$(cat /run/nginx.pid)"
        fi
    endscript
}
/var/log/letsencrypt/*.log {
    daily
    rotate 7
    maxsize 5M
    missingok
    notifempty
    compress
    create 0600 root root
}
